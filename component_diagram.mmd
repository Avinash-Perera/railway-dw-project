flowchart TD
    %% ==========================================
    %% 1. RAW DATA SOURCE COMPONENT
    %% ==========================================
    subgraph COMP_DATA["«component» Raw Data Sources (5 Operational Feeds)"]
        direction TB
        F1["combined_delay.csv (38.4M rows — Station Arrival Telemetry)"]
        F2["combined_schedule.csv (172K rows — Master Timetable)"]
        F3["train_details.csv (8,992 rows — Train Master)"]
        F4["station_full_names.csv (8,963 rows — Station Master)"]
        F5["train_delays.csv (Journey Cancellations, Delay Causes & Weather)"]
    end

    %% ==========================================
    %% 2. PYTHON ETL INGESTION COMPONENT
    %% ==========================================
    subgraph COMP_ETL["«component» Python ETL & Validation Engine (etl/)"]
        direction TB
        ETL_CTRL["run_etl.py (Master Pipeline Orchestrator)"]
        ETL_DIM["load_dimensions.py (Phase 1: 8 Conformed Dimensions + SCD2 + Holiday/Time Generation)"]
        ETL_FACT["load_fact.py (Phase 2: 250K-Chunk Loader for Events 1–4 + Derived Measures)"]
        ETL_EVENT["load_event_facts.py (Phase 3: Events 5–7 Loader + Event 8 Daily Snapshot Rollup)"]
        ETL_VAL["validate_load.py (Phase 4: 68 Automated Reconciliation, SCD2 & RI Checks)"]
        ETL_CONN["db_connector.py (SQLAlchemy Connection Pool + LOAD DATA LOCAL INFILE)"]
        
        ETL_CTRL --> ETL_DIM
        ETL_CTRL --> ETL_FACT
        ETL_CTRL --> ETL_EVENT
        ETL_CTRL --> ETL_VAL
        ETL_DIM --> ETL_CONN
        ETL_FACT --> ETL_CONN
        ETL_EVENT --> ETL_CONN
        ETL_VAL --> ETL_CONN
    end

    COMP_DATA -->|"Streaming CSV Ingestion + Data Quality Filtering"| COMP_ETL

    %% ==========================================
    %% 3. DOCKER EXECUTION RUNTIME
    %% ==========================================
    subgraph DOCKER_RUNTIME["«execution environment» Docker Compose Runtime"]
        direction TB

        %% MySQL Component
        subgraph COMP_MYSQL["«component» OLAP Data Warehouse (railway_dw_mysql :3306)"]
            direction TB
            PORT_3306["«interface» Port 3306 (TCP)"]
            
            subgraph SQL_BOOT["SQL Bootstrap Scripts (sql/)"]
                INIT1["01_create_database.sql"]
                INIT2["02_create_star_schema.sql (8 Facts + 8 Dims)"]
                INIT3["03_indexes_and_views.sql (OLAP & KPI Views)"]
            end
            
            subgraph STAR_SCHEMA["Fact Constellation / Star Schema (railway_dw)"]
                TBL_DIMS[("8 Conformed Dimensions\n(Dim_Date, Dim_Time, Dim_Station, Dim_Train [SCD2],\nDim_DelayCategory, Dim_Weather, Dim_DelayReason, Dim_CancellationReason)")]
                TBL_FACT[("8 Business Event Fact Tables\n(Fact_TrainDelay, Fact_TrainSchedule, Fact_JourneyDeparture,\nFact_JourneyArrival, Fact_JourneyCancellation, Fact_DelayIncident,\nFact_WeatherObservation, Fact_TrainDailySnapshot)")]
                TBL_INDEX["Composite B-Tree Indexes\n(idx_fact_date_station, idx_fact_train_cat, idx_fact_time, idx_sched_train)"]
                TBL_VIEW["Analytical & KPI Views\n(vw_RailwayAnalytics, vw_KPI_Monthly,\nvw_KPI_WeekendUplift, vw_KPI_PeakSurge)"]
            end
            
            VOL_DATA[("«volume» mysql_dw_data (/var/lib/mysql)")]
            
            PORT_3306 --> STAR_SCHEMA
            STAR_SCHEMA --- VOL_DATA
        end

        %% Metabase Component
        subgraph COMP_META["«component» BI Analytics Engine (railway_bi_metabase :3000)"]
            direction TB
            PORT_3000["«interface» Port 3000 (HTTP)"]
            META_APP[("Internal App DB: metabase_db")]
            META_CACHE["Adaptive Query Caching Engine"]
            META_CORE["Metabase Query Runner (Native SQL)"]
            
            PORT_3000 --> META_CORE
            META_CORE --- META_APP
            META_CORE --- META_CACHE
        end

        %% Internal Docker Network
        COMP_META -->|"Internal Docker Bridge Network (mysql:3306)"| PORT_3306
    end

    ETL_CONN -->|"MySQL Protocol / Port 3306 (Bulk TSV Load)"| PORT_3306

    %% ==========================================
    %% 4. CLIENT & PRESENTATION LAYER
    %% ==========================================
    subgraph COMP_CLIENT["«component» Client, Reporting & Presentation Layer"]
        direction TB
        BROWSER["Web Browser UI (http://localhost:3000)"]
        DASHBOARD["Executive BI Dashboard (5 KPIs: Value, Goal, Status [G/A/R], Trend [MoM])"]
        DOC_GEN["generate_submission_docx.py & generate_model_diagrams.py\n(Bus Matrix, Star Schema, Traceability Report)"]
        
        BROWSER --> DASHBOARD
    end

    PORT_3000 -->|"HTTP REST API / JSON"| BROWSER
    STAR_SCHEMA -->|"Direct SQL Extraction"| DOC_GEN
